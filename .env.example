# Bu dosya ornektir. Gercek .env ASLA commit edilmez (.gitignore icinde).
# Uygulama bu dosya olmadan da tam calisir; LLM yalnizca opsiyonel anlati katmanidir.

PORT=8000
DATA_DIR=./data/katilimci_paketi

# --- Opsiyonel: dogal dil anlati katmani ---
# LLM_ENABLED=false birakilirsa deterministik kanit ozeti kullanilir (varsayilan).
LLM_ENABLED=false
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=claude-sonnet-4-5
